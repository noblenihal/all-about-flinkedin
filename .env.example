# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn Profile API — environment configuration
#
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── LinkedIn authentication ──────────────────────────────────────────────────
# The service needs a logged-in LinkedIn session. Pick ONE primary method.
# You may ALSO set credentials as a fallback alongside a cookie (recommended
# for production): if the cookie/jar is rejected, the service logs in with the
# credentials automatically.

# Method A — email + password (simplest for local/dev; a long-running server
# reuses the session and rarely re-logs-in). LINKEDIN_PASS is accepted as an
# alias for LINKEDIN_PASSWORD.
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=your-password

# Method B — a full cookie jar (RECOMMENDED for serverless / Vercel, where the
# filesystem is ephemeral and per-cold-start logins provoke challenges).
# Generate with:  npm run login:export
# Paste the single-line JSON it prints:
# LINKEDIN_COOKIE_JAR={"li_at":"...","JSESSIONID":"\"ajax:...\"","liap":"...","lidc":"...","bcookie":"..."}

# Method C — just the li_at cookie (copy from a browser: DevTools > Application >
# Cookies > linkedin.com > li_at). Lighter than the full jar but only reliable
# for a subset of endpoints; the full jar (Method B) is preferred.
# LINKEDIN_LI_AT=

# Optional companion for Method C.
# LINKEDIN_JSESSIONID=

# ── Outbound network ─────────────────────────────────────────────────────────
# Route LinkedIn traffic through a proxy. Set this if the deploy IP is blocked
# (symptoms: HTTP 999, or logins that always challenge). A residential proxy is
# most effective. HTTPS_PROXY / HTTP_PROXY are also honoured.
# LINKEDIN_PROXY_URL=http://user:pass@host:port

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Comma-separated API keys accepted in the `x-api-key` header. Leave empty to
# run an open API (fine for a demo). Set it in production so the deployment —
# and the LinkedIn account behind it — cannot be used as a free scraper.
# API_KEYS=key-one,key-two

# ── Rate limiting (inbound, per IP) ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# ── Response cache ───────────────────────────────────────────────────────────
CACHE_TTL_MS=900000
CACHE_MAX_ENTRIES=200

# ── LinkedIn client tuning ───────────────────────────────────────────────────
# Minimum gap between outbound LinkedIn calls (politeness / anti-throttle).
LINKEDIN_MIN_REQUEST_GAP_MS=900
# How long a healthy session is reused before a forced re-login (ms). Kept long
# on purpose — re-login is the operation most likely to trigger a challenge.
LINKEDIN_SESSION_MAX_AGE_MS=1728000000
# Where the session jar is persisted (a long-lived host reuses it across
# restarts). Ignore/leave default on read-only filesystems.
# LINKEDIN_SESSION_FILE=.session/linkedin.json
# Allow falling back to the logged-out public profile page (thin data) when the
# authenticated paths fail.
LINKEDIN_ALLOW_PUBLIC_FALLBACK=true
